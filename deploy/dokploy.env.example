# Paste into the application's Environment tab in Dokploy. Never commit filled-in values.

# mock is a public practice site with bots and fake burns, and needs nothing below.
# Change to mainnet only when docs/DOKPLOY.md says to.
MODE=mock
MAINNET_ENABLED=false

# Dokploy's Traefik is the one proxy in front of the server.
TRUST_PROXY_HOPS=1

# The Internal Connection URL of the Postgres service you create in Dokploy.
# Required for devnet and mainnet. Mock mode keeps everything in memory.
DATABASE_URL=

# Your pump.fun coin. Set it in any mode to show the contract address on the site.
COIN_MINT=

# The dev wallet, as base58 or a quoted JSON array of 64 bytes. A new wallet used for nothing else.
DEV_WALLET_PRIVATE_KEY=

# A paid Solana RPC that supports DAS getAsset, for example Helius.
SOLANA_RPC_URL=
# Only if the provider's WebSocket isn't at the same address as its RPC.
SOLANA_WS_URL=
# Only if SOLANA_RPC_URL can't answer getAsset.
DAS_RPC_URL=

JUPITER_API_KEY=
COLLECTOR_CRYPT_API_KEY=

# Discord or Slack webhook for anything that needs a person.
ALERT_WEBHOOK_URL=
