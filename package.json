{
  "name": "keepripping",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Last rip takes it all. A burn-to-rip trading card game on Solana.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node --import tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "sim": "tsx scripts/sim-round.ts",
    "pause": "tsx scripts/pause.ts on",
    "unpause": "tsx scripts/pause.ts off",
    "payout:retry": "tsx scripts/payout-retry.ts",
    "check:network": "tsx scripts/check-network.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@fastify/static": "^10.1.10",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/mpl-toolbox": "^0.10.0",
    "@metaplex-foundation/umi": "^1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.6.0",
    "@metaplex-foundation/umi-web3js-adapters": "^1.6.0",
    "@noble/hashes": "^1.8.0",
    "@pump-fun/pump-sdk": "^4.3.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-standard-features": "^1.5.0",
    "@solana/web3.js": "^1.99.0",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "lucide-react": "^1.69.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
