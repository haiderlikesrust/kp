# Leave MODE=mock to run locally with no keys: fake chain, demo wallets, bots.
# mock | devnet | mainnet
MODE=mock

# Must also be true for mainnet, so real money is never spent by accident.
MAINNET_ENABLED=false

PORT=3000
# Use 0.0.0.0 in production. Set to the number of proxies in front of the server.
HOST=127.0.0.1
TRUST_PROXY_HOPS=0

# Required in production. Without it, a local PGlite database is used.
DATABASE_URL=

# Your pump.fun coin.
COIN_MINT=

# The dev wallet's private key (base58, or a JSON byte array). It holds real
# USDC and cards and signs automatically, so use a new wallet for this only.
DEV_WALLET_PRIVATE_KEY=

# A paid Solana RPC. It must support DAS (getAsset), for example Helius.
SOLANA_RPC_URL=
# Only if DAS lives on a different URL.
DAS_RPC_URL=

# Used to convert creator fees to USDC.
JUPITER_API_KEY=

# Optional partner key, issued on Collector Crypt's Discord.
COLLECTOR_CRYPT_API_KEY=

# Discord or Slack webhook for anything that needs a person.
ALERT_WEBHOOK_URL=

# Tuning. Defaults are the agreed game rules.
# BURN_TOKENS=100000
# MIN_CLAIM_USD=5
# PRIORITY_MICROLAMPORTS=50000
# RESOLVE_HINT_MS=60000
# ROUND_GAP_SLOTS=0

# Mock mode only.
# MOCK_BOTS=true
# MOCK_START_USD=5200
